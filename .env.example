# Ejemplo de variables de entorno. COPIÁ este archivo a ".env" y poné TUS valores.
#   cp .env.example .env
# El archivo ".env" real está ignorado por .gitignore: NUNCA se sube al repo.
#
# Así se hace de verdad en una unit de systemd:
#   [Service]
#   EnvironmentFile=/etc/miapp.env      <- permisos 0600, dueño root
# En vez de:
#   Environment="DB_PASSWORD=..."       <- lo lee cualquiera con systemctl show

EJEMPLO_VALOR=cambiame
